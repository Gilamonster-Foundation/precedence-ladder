#!/usr/bin/env bash
# PIPELINE PARITY: mirrors the `fmt`, `clippy`, `test`, `doc`, `leaf-deps` and
# `vectors` jobs in .github/workflows/ci.yml, the `sorry`-grep half of
# .github/workflows/formal.yml, and the release-notes half of
# .github/workflows/release.yml's `provenance` job. When editing this file,
# verify it still matches all three pipelines; do not bypass it with
# --no-verify.
#
# This repo is small enough to mirror its pipeline HONESTLY — the whole gate is
# seconds, not the ~50-minute whole-workspace hook that made `--no-verify` a
# standing exception in newt-agent (#1098). Do not inherit that shape here: the
# moment this hook stops being humane, people route around it and the parity is
# fiction.
#
# DOCUMENTED EXCEPTIONS — two CI steps are deliberately NOT run here, and for
# the same reason in both cases: each needs a whole extra toolchain installed.
#   - `msrv` (build+test on dtolnay/rust-toolchain@1.88): installing a second
#     Rust toolchain on every push is too heavy for a fast hook, so the MSRV
#     floor is guarded CI-only. The declared floor lives in Cargo.toml's
#     `rust-version`, which this hook respects implicitly. Run it with
#     `just msrv`.
#   - `formal`'s `lake build` (every Lean theorem): needs a Lean toolchain via
#     elan. Requiring a Lean install of everyone who pushes to a Rust crate is
#     disproportionate; newt-agent's `formal.yml` records the same decision.
#     Run it with `just lean`.
#
# release.yml adds four more exceptions, each for the same class of reason —
# it is TAG-triggered, so most of it has nothing to mirror at push time:
#   - `provenance`'s tag checks need a tag, which does not exist on a push.
#   - `cargo publish --dry-run` packs the crate and rebuilds it from the
#     tarball; `--locked` supersets and `msrv` need a second toolchain.
#     Run all of it with `just release-dryrun`.
#   - `scripts/verify_release.py` needs a Python interpreter — the same
#     exception ci.yml's `version-drift` job already records.
# What IS mirrorable from release.yml is mirrored, at the bottom of this file:
# the release-notes check, which is pure text.
#
# The `doc`, `leaf-deps` and `vectors` jobs ARE mirrored below (rustdoc is
# cheap, the leaf guard only reads `cargo metadata`, and the vector check is one
# generator run plus a diff) — true parity, not an exception. So is the OTHER
# half of `formal.yml`, the `sorry` grep, which is pure grep.
#
# `exec 1>&2` is not cosmetic: a hook that writes to stdout can inject bytes
# into git's remote-helper protocol and corrupt an HTTPS push. Everything this
# hook prints goes to stderr.
set -euo pipefail
exec 1>&2

echo "==> cargo fmt --check"
cargo fmt -- --check

echo "==> cargo clippy --all-targets --all-features -- -D warnings"
cargo clippy --all-targets --all-features -- -D warnings

echo "==> cargo clippy --all-targets --no-default-features -- -D warnings"
cargo clippy --all-targets --no-default-features -- -D warnings

# The bare predicate. `tests/guard.rs` asserts this configuration has an EMPTY
# dependency closure, so it has to compile and pass on its own.
echo "==> cargo test --no-default-features (the bare predicate)"
cargo test --no-default-features

echo "==> cargo test (default: + the 'table' feature)"
cargo test

echo "==> cargo test --all-features (+ the default-OFF 'cid' feature)"
cargo test --all-features

# Mirrors the CI `doc` job: `-D warnings` turns a broken intra-doc link into a
# hard failure so doc rot can't return.
echo "==> RUSTDOCFLAGS=-D warnings cargo doc --no-deps --all-features"
RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --all-features

# Mirrors the CI `leaf-deps` job: the closure must stay registry-only at every
# feature setting. Reads only `cargo metadata` — fast.
echo "==> ./scripts/check-leaf-deps.sh (this crate is a true leaf)"
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-leaf-deps.sh"

# Mirrors the CI `vectors` job. `spec/vectors/ladder.json` and
# `formal/Precedence/Vectors.lean` are generated by the real `Ladder::resolve`;
# this regenerates them and fails on a diff. It is the only thing tying the Lean
# proofs to the shipped Rust, so it belongs on the fast path.
echo "==> ./scripts/check-vectors.sh (the golden vectors are not stale)"
"$root/scripts/check-vectors.sh"

# Mirrors the `sorry`-grep half of .github/workflows/formal.yml. Pure grep, no
# Lean toolchain — `lake build` is the documented exception above.
echo "==> ./scripts/check-lean-proofs.sh (no sorry, no native_decide)"
"$root/scripts/check-lean-proofs.sh"

# Mirrors the release-notes half of .github/workflows/release.yml's `provenance`
# job. The release body IS the CHANGELOG section verbatim, so a version bump
# that forgets the entry publishes an empty release — after the tag is already
# pushed and crates.io has already accepted the crate. Pure text, no toolchain,
# milliseconds, so there is no excuse for it to be release-only.
echo "==> ./scripts/release-notes.sh (the declared version has a CHANGELOG section)"
"$root/scripts/release-notes.sh" >/dev/null

echo "pre-push checks passed."
