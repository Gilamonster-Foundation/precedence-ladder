theorem demo_vectors_agree : demoCases.all (caseOk demoLadder) = true := by decide

/-- Non-vacuity: the grid really does produce these exact counts of each
    verdict kind. `demo_vectors_agree` alone would be satisfied by a grid
    that had collapsed to a single kind. -/
theorem demo_verdict_distribution :
    tally demoLadder demoCases = (62, 33, 97) := by decide

/-- **A ladder is not a set.** The same 192 inputs against the same rungs in
    the opposite order give a different answer vector, so rung ORDER is
    observable. This is the deliberate negation of a position-independence
    law. -/
theorem demo_order_is_load_bearing :
    outcomes demoLadder demoCases ≠ outcomes demoLadderReversed demoCases := by
  decide

